{
  "name": "functions",
  "description": "Cloud Functions FaithFocus (Tâche 9 : soumission de leçon et leaderboard hebdomadaire).",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "type": "commonjs",
  "scripts": {
