  },
  "devDependencies": {
    "@types/mocha": "^10.0.9",
    "@types/node": "^22.10.1",
    "mocha": "^10.8.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.5",
    "typescript": "^5.7.2"
  },
  "private": true
}
