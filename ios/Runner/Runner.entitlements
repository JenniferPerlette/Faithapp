<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Entitlement soumis à approbation Apple (formulaire dédié) — cf.
	     limitations en fin de Tâche 6, non activable sans cette démarche. -->
